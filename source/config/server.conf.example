# Online Gobang server configuration
# Lines starting with # are comments.

# Server
server_port     = 8080
server_threads  = 4

# Database
# Use your local database credentials.
db_host         = 127.0.0.1
db_port         = 3306
db_user         = your_db_user
db_password     = your_db_password
db_name         = gobang_db
db_pool_size    = 10

# Logging
log_file        = logs/server.log
log_level       = INFO
log_max_bytes   = 10485760

# Gameplay
reconnect_timeout  = 60
match_timeout      = 30
heartbeat_interval = 30

# JWT
# Must be at least 32 chars and contain at least two character classes.
jwt_secret   = "CHANGE_ME_TO_A_RANDOM_SECRET_32+_CHARS!"
jwt_issuer   = "online_gobang"
jwt_expire   = 86400
